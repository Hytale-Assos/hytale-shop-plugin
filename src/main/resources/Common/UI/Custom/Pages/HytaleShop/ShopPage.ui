$C = "../../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 900, Height: 720);

  #Title {
    Label #ShopTitle {
      Style: (
        ...$C.@TitleStyle,
        HorizontalAlignment: Center,
      );
      Padding: (Horizontal: 19);
      Text: "Shop";
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Horizontal: 10);

    // Balance, search and the shared quantity
    Group #Header {
      LayoutMode: Left;
      Anchor: (Height: 40, Bottom: 6);

      Label #Balance {
        FlexWeight: 1;
        Style: (
          FontSize: 18,
          TextColor: #E8A93B,
          RenderBold: true,
          VerticalAlignment: Center,
        );
        Text: "";
      }

      $C.@TextField #SearchInput {
        Anchor: (Width: 200, Height: 38, Right: 4);
        PlaceholderText: "Search (ex: stone)";
      }

      $C.@SmallSecondaryTextButton #SearchButton {
        @Text = "Search";
        Anchor: (Width: 86, Height: $C.@SmallButtonHeight, Top: 3, Right: 16);
        Padding: (Horizontal: 6);
      }

      Label #QuantityLabel {
        Anchor: (Width: 80);
        Padding: (Right: 8);
        Style: (
          FontSize: 14,
          TextColor: #96a9be,
          HorizontalAlignment: End,
          VerticalAlignment: Center,
          RenderUppercase: true,
          RenderBold: true,
        );
        Text: "Qty";
      }

      $C.@TextField #QuantityInput {
        Anchor: (Width: 80, Height: 38);
      }
    }

    // Category tabs; the active one is disabled by the server
    Group #Categories {
      LayoutMode: LeftCenterWrap;
      Anchor: (Height: 72, Bottom: 4);

      $C.@SmallSecondaryTextButton #CatAll { @Text = "All"; Anchor: (Width: 92, Height: 32, Right: 4, Bottom: 4); Padding: (Horizontal: 4); }
      $C.@SmallSecondaryTextButton #CatRocks { @Text = "Rocks"; Anchor: (Width: 92, Height: 32, Right: 4, Bottom: 4); Padding: (Horizontal: 4); }
      $C.@SmallSecondaryTextButton #CatSoils { @Text = "Soils"; Anchor: (Width: 92, Height: 32, Right: 4, Bottom: 4); Padding: (Horizontal: 4); }
      $C.@SmallSecondaryTextButton #CatWood { @Text = "Wood"; Anchor: (Width: 92, Height: 32, Right: 4, Bottom: 4); Padding: (Horizontal: 4); }
      $C.@SmallSecondaryTextButton #CatPlants { @Text = "Plants"; Anchor: (Width: 92, Height: 32, Right: 4, Bottom: 4); Padding: (Horizontal: 4); }
      $C.@SmallSecondaryTextButton #CatMetal { @Text = "Metal"; Anchor: (Width: 92, Height: 32, Right: 4, Bottom: 4); Padding: (Horizontal: 4); }
      $C.@SmallSecondaryTextButton #CatCloth { @Text = "Cloth"; Anchor: (Width: 92, Height: 32, Right: 4, Bottom: 4); Padding: (Horizontal: 4); }
      $C.@SmallSecondaryTextButton #CatDeco { @Text = "Deco"; Anchor: (Width: 92, Height: 32, Right: 4, Bottom: 4); Padding: (Horizontal: 4); }
      $C.@SmallSecondaryTextButton #CatOres { @Text = "Ores"; Anchor: (Width: 92, Height: 32, Right: 4, Bottom: 4); Padding: (Horizontal: 4); }
      $C.@SmallSecondaryTextButton #CatFurniture { @Text = "Furniture"; Anchor: (Width: 92, Height: 32, Right: 4, Bottom: 4); Padding: (Horizontal: 4); }
      $C.@SmallSecondaryTextButton #CatOther { @Text = "Other"; Anchor: (Width: 92, Height: 32, Right: 4, Bottom: 4); Padding: (Horizontal: 4); }
    }

    // Result of the last action, set by the server
    Label #Status {
      Anchor: (Height: 24, Bottom: 4);
      Style: (
        FontSize: 14,
        TextColor: #96a9be,
        HorizontalAlignment: Center,
        VerticalAlignment: Center,
      );
      Text: "";
    }

    // One Pages/HytaleShop/ShopItemRow.ui per item of the current page, appended by the server
    Group #ItemList {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Right: 8);
    }

    Group #Pager {
      LayoutMode: Center;
      Anchor: (Height: 40, Top: 6);

      $C.@SmallSecondaryTextButton #PrevButton {
        @Text = "< Prev";
        Anchor: (Width: 100, Height: $C.@SmallButtonHeight, Right: 8);
      }

      Label #PageLabel {
        Anchor: (Width: 220);
        Style: (
          FontSize: 14,
          TextColor: #96a9be,
          HorizontalAlignment: Center,
          VerticalAlignment: Center,
        );
        Text: "";
      }

      $C.@SmallSecondaryTextButton #NextButton {
        @Text = "Next >";
        Anchor: (Width: 100, Height: $C.@SmallButtonHeight, Left: 8);
      }
    }
  }
}

$C.@BackButton {}
